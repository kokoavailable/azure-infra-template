# subscription_id / tenant_id: set once in ../../terraform.shared.tfvars (see platform/terraform.shared.tfvars.example);
# repo-root `make plan|apply STACK=platform/management/03-policy-governance` loads it automatically.

project_prefix = "plt"

# Documented RG naming convention for humans/modules (no policy enforcement in this stack)
# resource_group_name_pattern = "rg-<org>-<env>-<region>-<workload>"

assign_require_environment_tag_on_rg = true
# mandatory_resource_group_tag_keys = ["environment", "costcenter"]

allowed_azure_regions = ["koreacentral"]
